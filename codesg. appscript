/* =====================================================
   NORMALIZE DATE
===================================================== */

function normalizeDateValue_(value) {

  if (!value) {
    return "";
  }


  const timezone =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSpreadsheetTimeZone()
      ||
      Session.getScriptTimeZone()
      ||
      "Asia/Manila";


  /*
    Date object
  */

  if (
    Object.prototype.toString
      .call(value)
    === "[object Date]"
  ) {

    if (isNaN(value.getTime())) {
      return "";
    }


    return Utilities.formatDate(
      value,
      timezone,
      "yyyy-MM-dd"
    );
  }


  /*
    String
  */

  const text =
    String(value).trim();


  /*
    Already yyyy-MM-dd
  */

  if (
    /^\d{4}-\d{2}-\d{2}$/
      .test(text)
  ) {

    return text;
  }


  /*
    Try parse
  */

  const parsed =
    new Date(text);


  if (!isNaN(parsed.getTime())) {

    return Utilities.formatDate(
      parsed,
      timezone,
      "yyyy-MM-dd"
    );
  }


  return text;
}


/* =====================================================
   FORMAT TIME
===================================================== */

function formatTime_(value) {

  if (!value) {
    return "";
  }


  const timezone =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSpreadsheetTimeZone()
      ||
      Session.getScriptTimeZone()
      ||
      "Asia/Manila";


  if (
    Object.prototype.toString
      .call(value)
    === "[object Date]"
  ) {

    if (isNaN(value.getTime())) {
      return "";
    }


    return Utilities.formatDate(
      value,
      timezone,
      "HH:mm:ss"
    );
  }


  return String(value);
}


/* =====================================================
   SECONDS SINCE
===================================================== */

function secondsSince(value) {

  if (!value) {
    return -1;
  }


  let dateValue;


  if (
    Object.prototype.toString
      .call(value)
    === "[object Date]"
  ) {

    dateValue = value;

  } else {

    dateValue = new Date(value);

  }


  if (isNaN(dateValue.getTime())) {
    return -1;
  }


  return (
    new Date().getTime()
    -
    dateValue.getTime()
  ) / 1000;
}


/* =====================================================
   DEACTIVATE PERSON
===================================================== */

function deactivatePerson(personId) {

  setupSheets_();


  const sheet =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(
        SHEETS.PEOPLE
      );


  const data =
    sheet.getDataRange().getValues();


  for (
    let i = 1;
    i < data.length;
    i++
  ) {

    if (
      String(data[i][0])
      === String(personId)
    ) {

      sheet
        .getRange(i + 1, 9)
        .setValue("INACTIVE");


      writeAudit_(
        "PERSON_DEACTIVATED",
        personId,
        "",
        "Person deactivated"
      );


      return {

        success: true,

        message:
          "PERSON DEACTIVATED"
      };
    }
  }


  return {

    success: false,

    message:
      "PERSON NOT FOUND"
  };
}


