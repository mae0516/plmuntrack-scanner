/*******************************************************
 * PLMunTrack
 * QR Code-Based Attendance Management System
 *
 * IMPORTANT ATTENDANCE RULE:
 * 1st scan  = CHECK IN
 * 2nd scan  = CHECK OUT on SAME ROW
 * 3rd scan  = ATTENDANCE ALREADY COMPLETED FOR TODAY
 *******************************************************/


/* =====================================================
   SHEETS
===================================================== */

const SHEETS = {
  PEOPLE: "People",
  QR: "QR_Tokens",
  ATTENDANCE: "Attendance",
  ADMINS: "Admins",
  AUDIT: "Audit"
};


/* =====================================================
   HEADERS
===================================================== */

const HEADERS = {

  PEOPLE: [
    "Person ID",
    "Name",
    "Type",
    "Email",
    "Student/Visitor ID",
    "Course",
    "Year",
    "Section",
    "Status"
  ],

  QR: [
    "QR ID",
    "Person ID",
    "Date",
    "Token",
    "Status"
  ],

  ATTENDANCE: [
    "Scan ID",
